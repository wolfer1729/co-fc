# hw definition file for processing by chibios_hwdef.py
# CubeRed project board using the NucleoH743 hardware layout

AUTOBUILD_TARGETS None

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# crystal frequency
OSCILLATOR_HZ 8000000

define STM32_HSE_BYPASS

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID 149

FLASH_SIZE_KB 2048

# ChibiOS system timer
STM32_ST_USE_TIMER 2

FLASH_RESERVE_START_KB 128

# order of UARTs (and USB)
SERIAL_ORDER OTG1 USART2 USART6 UART7

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# Port switching for USB HS and FS,high = USB_FS , LOW = USB_HS
PH15 USB_HS_ENABLE OUTPUT HIGH

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define HAL_USE_EMPTY_STORAGE 0
define AP_CHECK_FIRMWARE_ENABLED 1
define AP_BOOTLOADER_FLASHING_ENABLED 0

# LED_BOOTLOADER = PB0
PB0 LED_BOOTLOADER OUTPUT OPENDRAIN LOW GPIO(16)
# LED_ACTIVITY = PB7
PB7 LED_ACTIVITY OUTPUT OPENDRAIN LOW GPIO(23)

# LD3 (Red) - PB14
#PB14 LED_RED OUTPUT OPENDRAIN LOW GPIO(30)

# Assign LEDs to Notify system
#define AP_NOTIFY_GPIO_LED_GREEN_PIN   5
#define AP_NOTIFY_GPIO_LED_YELLOW_PIN 65
#define AP_NOTIFY_GPIO_LED_RED_PIN    30

# Disable PixRacer RGB handling
#undef AP_NOTIFY_GPIO_LED_RGB_ENABLED

define AP_NOTIFY_GPIO_ENABLED 1

# enable RAMTROM parameter storage
#define HAL_STORAGE_SIZE 32768
#define HAL_WITH_RAMTRON 1

# allow to have a dedicated safety switch pin
define HAL_HAVE_SAFETY_SWITCH 1
PE12 LED_SAFETY OUTPUT
PE10 SAFETY_IN INPUT PULLDOWN

define HAL_SPI_CHECK_CLOCK_FREQ

# sensor CS
PC7 BARO_CS CS
PA9 ICM42688_CS CS
PF3 BMI088_A_CS CS
PF4 BMI088_G_CS CS
PF10 ADIS16470_CS CS
PE15 FLASH_CS CS

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

# SPI1
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

# SPI3
PB3 SPI3_SCK SPI3
PB4 SPI3_MISO SPI3
PB5 SPI3_MOSI SPI3

PE7 DRDY1_ADIS16470 INPUT GPIO(93)
define ADIS_DRDY_PIN 93

# USART2 is telem1
PD6 USART2_RX USART2
PD5 USART2_TX USART2
PD3 USART2_CTS USART2
PD4 USART2_RTS USART2

# USART6 is telem2
PG9 USART6_RX USART6
PG14 USART6_TX USART6
PG15 USART6_CTS USART6
PG8 USART6_RTS USART6

# UART7 is debug
PF6 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

# PWM AUX channels
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(58)
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(59)

# I2C buses
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2
PH7 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3
PF14 I2C4_SCL I2C4
PF15 I2C4_SDA I2C4

I2C_ORDER I2C3 I2C1 I2C2 I2C4

# analog in
PA0 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PA1 BATT_CURRENT_SENS ADC1 SCALE(1)
PC4 SPARE1_ADC1 ADC1 SCALE(1)
PA4 SPARE2_ADC1 ADC1 SCALE(1)
PF12 RSSI_IN ADC1 SCALE(1)
PC5 VDD_5V_SENS ADC1 SCALE(2)
PC1 SCALED_V3V3 ADC1 SCALE(2)
PB1 FMU_SERVORAIL_VCC_SENS ADC1 SCALE(3)

# CAN bus
PI9 CAN1_RX CAN1
PH13 CAN1_TX CAN1
PB12 CAN2_RX CAN2
PB13 CAN2_TX CAN2
PH2 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)
PH3 GPIO_CAN2_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(71)
PG1 VDD_BRICK_nVALID INPUT PULLUP

define HAL_I2C_INTERNAL_MASK 1

# SPI devices
SPIDEV ms5611   SPI3 DEVID2 BARO_CS     MODE3 8*MHZ 8*MHZ
SPIDEV icm42688 SPI3 DEVID1 ICM42688_CS MODE3 2*MHZ 8*MHZ
SPIDEV sdcard   SPI1 DEVID1 FLASH_CS    MODE0 400*KHZ 25*MHZ

define HAL_STORAGE_SIZE 16384
define HAL_WITH_RAMTRON 1

# probe for an invensense IMU
IMU Invensensev3 SPI:icm42688 ROTATION_PITCH_180_YAW_270

# and ms5611 baro
BARO MS5611 SPI:ms5611

# COMPASS BMM350 in I2C
COMPASS BMM350 I2C:ALL_EXTERNAL:0x14 true ROTATION_ROLL_180_YAW_90

# Disable embedded bootloader packaging for the fixed-hash secure-boot trial.
# Otherwise the app hash changes every time the bootloader hash changes.
