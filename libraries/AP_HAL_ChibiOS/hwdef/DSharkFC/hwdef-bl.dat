# hw definition file for the Digital Shark Technology custom FCU bootloader
# STM32H753XIH6 - pins confirmed against the board schematic

MCU STM32H7xx STM32H743xx

# crystal frequency (16MHz/12pF HSE on schematic)
OSCILLATOR_HZ 16000000

# board ID. See Tools/AP_Bootloader/board_types.txt
APJ_BOARD_ID AP_HW_DSHARK_FC

FLASH_SIZE_KB 2048

# bootloader is installed at zero offset
FLASH_RESERVE_START_KB 0

# the location where the bootloader will put the firmware
# the H743/H753 has 128k sectors
FLASH_BOOTLOADER_LOAD_KB 128

# ChibiOS system timer
STM32_ST_USE_TIMER 2

# order of UARTs (and USB) available in the bootloader
SERIAL_ORDER OTG1 USART2 USART6 UART7

# USB
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# USART2 is Telem1
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# USART6 is Telem2
PC6 USART6_TX USART6
PC7 USART6_RX USART6

# UART7 is the debug console
PF6 UART7_RX UART7 NODMA
PF7 UART7_TX UART7 NODMA

define BOOTLOADER_DEBUG_PRINTS 1
